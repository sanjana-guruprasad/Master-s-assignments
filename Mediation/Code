med.model <- "
# the c and b paths
  meanswb ~ c * meanopen + b * meansc
# the a path
  meansc ~ a * meanopen
# indirect and total effects
ab := a*b
total := ab+c
"

mediation.model.fit <-  sem(med.model, data=college, se = "bootstrap", bootstrap = 5000)
summary(mediation.model.fit, fit.measures=TRUE, standardized=TRUE, ci = TRUE)
lavInspect(mediation.model.fit, what = "rsquare")
semPaths(mediation.model.fit, "std")

#run overidentified model
