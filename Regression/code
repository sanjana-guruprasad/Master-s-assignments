#Low but significant correlation

#Can negative emotions about the impact of global warming be used to make predictions about support for government climate change policy?

climate.model <- lm(gov_support ~ 1 + neg_emotion, data = climate)
climate.model
summary(climate.model)
confint(climate.model)
check_model(climate.model)
climate$zgov_support <- scale(climate$gov_support)
climate$zneg_emotion <- scale(climate$neg_emotion)
climate

lm.beta(climate.model)
#regression coefficient is significant but low

climate$predicted <- predict(climate.model)
climate

climate$residuals <- resid(climate.model)
climate

supernova(climate.model)

#3) a. Does the effect of negative emotions on government support remain in a multiple regression model controlling for egalitarian and individualism?
#b. When age and gender is added to the multiple regression model in 3a, what is the most important predictor of government support (i.e., age, gender, negative emotions, egalitarianism, or individualism)?

rcorr(as.matrix(climate[,c("neg_emotion","gov_support", "egal", "indv")], type="pearson"))

multiple.climate.model <- lm(gov_support ~ 1 + neg_emotion + egal + indv, data = climate)
summary(multiple.climate.model)
supernova(multiple.climate.model)
check_model(multiple.climate.model)

#holding egalitarianism and individualism constant, the impact of negative emption on government support isn't significant. it only increases by 0.06 units
#corellations (significant) : negative emotion has positive correlation with government support and egalitarianism but negative correlation with individualism. individualism and government support are not correlated significnatly. individualism has negative correlation with negative emotion and egalitarianism

lm.beta(multiple.climate.model)
#Holding negative emotion and individualism constant, for every 1-unit increase in egalitarianism, government support increases by 0.32 units

multiple.climate.model1 <- lm(gov_support ~ 1 + neg_emotion + egal + indv + age + gender, data = climate)
summary(multiple.climate.model1)
supernova(multiple.climate.model1)
shapiro.test(multiple.climate.model1$residuals)

qqnorm(multiple.climate.model1$residuals)
qqline(multiple.climate.model1$residuals)
hist(multiple.climate.model1$residuals)
multiple.climate.model2 <- Boot(multiple.climate.model1, R=5000)
summary(multiple.climate.model2)
confint(multiple.climate.model2, type="perc")


#gender explains 1% of the model, age explains 2%, individualism explain 0.3%, egalitarianism explains 3% and negative emotion explains 0.4%. In summary, neither of these factors majorly explain support for government climate change policies.


