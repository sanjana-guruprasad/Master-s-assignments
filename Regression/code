climate_cov <- climate %>%
  select (gov_support, neg_emotion)
cov(climate_cov, method = "spearman")

climate_cov <- climate %>%
  select (gov_support, neg_emotion)
cov(climate_cov, method = "pearson")

#Do negative emotions about the impact of global warming correlate with support for government climate change policy?

rcorr(as.matrix (climate_cov), type = "pearson")

climate_cov %>%
  ggplot(aes(x = neg_emotion, y = gov_support)) +
  geom_point() +
  stat_smooth(method = "lm",
              col = "red",
              se = FALSE,
              size = 1) +
